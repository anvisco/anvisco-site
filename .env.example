# Anvisco - environment variables
# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local. Only this .env.example file should be committed.

# ----- Required for backend (Pass 1) -----
# Supabase project URL (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to ship to the browser. RLS protects data.
VITE_SUPABASE_ANON_KEY=

# Public site URL. Used for redirects and email templates.
VITE_SITE_URL=http://localhost:5173

# ----- Optional / future passes -----
# Stripe hosted Payment Links (one per offer). v1 is hosted, no card data is stored.
VITE_STRIPE_PAYMENT_LINK_AUDIT=
VITE_STRIPE_PAYMENT_LINK_ESSENTIALS=
VITE_STRIPE_PAYMENT_LINK_STANDARD=
VITE_STRIPE_PAYMENT_LINK_PREMIUM=

# Server-side only (used by future Edge Functions or scripts). Never expose to the browser.
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
