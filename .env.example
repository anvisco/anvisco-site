# Anvisco - environment variables
# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local. Only this .env.example file should be committed.

# ----- Frontend-safe values -----
# Supabase project URL (https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to ship to the browser. RLS protects data.
VITE_SUPABASE_ANON_KEY=

# Public site URL. Used for redirects and email templates.
VITE_SITE_URL=http://localhost:5173

# ----- Server-side only -----
# Never expose these to browser code. Add them as Supabase Edge Function secrets.
ANVIS_SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Optional server-side utilities. Never expose to the browser.
RESEND_API_KEY=
EMAIL_FROM=
